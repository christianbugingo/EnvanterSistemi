# Copy to ~/.inventorysystem/.env on EVERY shop computer (Windows: %USERPROFILE%\.inventorysystem\.env).
# Replace shop-server.local with the server's LAN hostname and set the database password.
# MySQL server, database, user, firewall and trusted TLS certificate must be configured first.
DB_URL='jdbc:mysql://shop-server.local:3306/inventory_shop?sslMode=VERIFY_IDENTITY&connectionTimeZone=LOCAL&connectTimeout=5000&socketTimeout=10000'
DB_USER=inventory_app
DB_PASSWORD='REPLACE_WITH_YOUR_DATABASE_PASSWORD'
SHOP_CURRENCY=TRY
