# Automatically read at startup. File values are literal (no shell expansion).
# Priority: JVM properties > environment variables > first available .env file.
# File search: ~/.inventorysystem/.env, ./.env, ./InventorySystemi/.env.
# Set INVENTORY_ENV_FILE to explicitly choose a different file.

# Single-computer demo (H2). These are DATABASE credentials, not staff logins.
DB_URL='jdbc:h2:file:~/.inventorysystem/inventory;MODE=MySQL;DATABASE_TO_LOWER=TRUE'
DB_USER=sa
DB_PASSWORD=''
SHOP_CURRENCY=TRY

# Create the first admin in the login window; create staff in Staff accounts.
# No login password is seeded by this file. Use .env.shop.example for a shared shop.
