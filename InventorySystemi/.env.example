# Optional offline settings. No database server or internet is needed.
# Defaults already use this local database; do not set a remote JDBC URL.
DB_URL='jdbc:h2:file:~/.inventorysystem/inventory;MODE=MySQL;DATABASE_TO_LOWER=TRUE'
DB_USER=sa
DB_PASSWORD=''
SHOP_CURRENCY=TRY
# Database credentials are separate from admin/staff login passwords.
# Create the first administrator in the login window and staff in Staff accounts.
