{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Inventory System (JavaFX)",
      "type": "shell",
      "command": "${workspaceFolder}/mvnw",
      "args": [
        "javafx:run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/mvnw.cmd"
      }
    },
    {
      "label": "Test Inventory System",
      "type": "shell",
      "command": "${workspaceFolder}/mvnw",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/mvnw.cmd"
      }
    },
    {
      "label": "Package Inventory System (macOS)",
      "type": "shell",
      "command": "bash",
      "args": [
        "scripts/package-macos.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}/InventorySystemi"
      },
      "problemMatcher": []
    },
    {
      "label": "Package Inventory System (Windows portable)",
      "type": "shell",
      "command": "python3",
      "args": [
        "scripts/package-windows-portable.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}/InventorySystemi"
      },
      "problemMatcher": []
    }
  ]
}
